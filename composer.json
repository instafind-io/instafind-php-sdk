{
    "name": "instafind/php-sdk",
    "description": "The official PHP SDK for the Instafind search and integration APIs.",
    "type": "library",
    "license": "MIT",
    "keywords": ["instafind", "search", "sdk", "ecommerce"],
    "homepage": "https://github.com/instafind-io/instafind-php-sdk",
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8",
        "php-stubs/wordpress-stubs": "^6.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "suggest": {
        "ext-curl": "For the default transport, CurlTransport.",
        "psr/http-client": "To send requests through your own PSR-18 client with Psr18Transport.",
        "psr/http-factory": "Needed with psr/http-client for Psr18Transport."
    },
    "autoload": {
        "psr-4": {
            "Instafind\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Instafind\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
